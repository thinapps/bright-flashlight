<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="6dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/power_button_disabled_shadow" />
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/power_button_disabled_start"
                android:endColor="@color/power_button_disabled_end" />
            <stroke
                android:width="2dp"
                android:color="@color/power_button_disabled_stroke" />
        </shape>
    </item>
</layer-list>
