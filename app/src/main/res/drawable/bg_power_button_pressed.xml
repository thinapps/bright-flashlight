<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#8F2100" />
        </shape>
    </item>

    <item android:top="4dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFF6F24"
                android:centerColor="#FFE63A00"
                android:endColor="#FFB82400" />
            <stroke
                android:width="2dp"
                android:color="#FFFF9550" />
        </shape>
    </item>
</layer-list>
