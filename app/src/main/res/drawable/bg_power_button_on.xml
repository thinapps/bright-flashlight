<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="8dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/power_button_on_shadow" />
        </shape>
    </item>

    <item android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/power_button_on_start"
                android:centerColor="@color/power_button_on_center"
                android:endColor="@color/power_button_on_end" />
            <stroke
                android:width="2dp"
                android:color="@color/power_button_on_stroke" />
        </shape>
    </item>

    <item android:left="20dp" android:top="16dp" android:right="20dp" android:bottom="94dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/power_button_on_highlight_start"
                android:endColor="@color/power_button_highlight_end" />
        </shape>
    </item>
</layer-list>
