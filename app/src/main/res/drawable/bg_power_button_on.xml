<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_button_active_glow" />

    <item
        android:top="@dimen/power_shadow_inset_top"
        android:left="@dimen/power_shadow_inset_side"
        android:right="@dimen/power_shadow_inset_side">
        <shape android:shape="oval">
            <solid android:color="@color/power_button_on_shadow" />
        </shape>
    </item>

    <item android:bottom="@dimen/power_face_inset_bottom">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/power_button_on_start"
                android:centerColor="@color/power_button_on_center"
                android:endColor="@color/power_button_on_end" />
            <stroke
                android:width="@dimen/thin_stroke_width"
                android:color="@color/power_button_on_stroke" />
        </shape>
    </item>

    <item
        android:left="@dimen/power_highlight_on_side"
        android:top="@dimen/power_highlight_on_top"
        android:right="@dimen/power_highlight_on_side"
        android:bottom="@dimen/power_highlight_on_bottom">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/power_button_on_highlight_start"
                android:endColor="@color/power_button_highlight_end" />
        </shape>
    </item>
</layer-list>
