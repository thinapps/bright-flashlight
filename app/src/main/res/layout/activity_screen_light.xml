<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/screen_light_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/screen_light_controls_padding"
        android:layout_gravity="bottom"
        android:background="@color/screen_light_controls_scrim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvColor"
            android:text="@string/screen_color"
            android:textColor="@color/md_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="@string/screen_presets"
            android:textColor="@color/md_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_light_label_top_margin" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupScreenPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_light_presets_top_margin"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetWhite"
                android:layout_width="0dp"
                android:layout_height="@dimen/screen_light_preset_button_height"
                android:layout_weight="1"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/screen_preset_white"
                android:textColor="@color/screen_preset_text_dark"
                app:backgroundTint="@color/screen_preset_white"
                app:cornerRadius="@dimen/screen_light_preset_corner_radius"
                app:rippleColor="@color/screen_button_ripple"
                app:strokeColor="@color/screen_preset_tile_stroke"
                app:strokeWidth="@dimen/screen_light_preset_tile_stroke_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetWarm"
                android:layout_width="0dp"
                android:layout_height="@dimen/screen_light_preset_button_height"
                android:layout_weight="1"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/screen_preset_warm"
                android:textColor="@color/screen_preset_text_dark"
                app:backgroundTint="@color/screen_preset_warm"
                app:cornerRadius="@dimen/screen_light_preset_corner_radius"
                app:rippleColor="@color/screen_button_ripple"
                app:strokeColor="@color/screen_preset_tile_stroke"
                app:strokeWidth="@dimen/screen_light_preset_tile_stroke_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetRed"
                android:layout_width="0dp"
                android:layout_height="@dimen/screen_light_preset_button_height"
                android:layout_weight="1"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/screen_preset_red"
                android:textColor="@color/screen_preset_text_light"
                app:backgroundTint="@color/screen_preset_red"
                app:cornerRadius="@dimen/screen_light_preset_corner_radius"
                app:rippleColor="@color/screen_button_ripple"
                app:strokeColor="@color/screen_preset_tile_stroke"
                app:strokeWidth="@dimen/screen_light_preset_tile_stroke_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetBlue"
                android:layout_width="0dp"
                android:layout_height="@dimen/screen_light_preset_button_height"
                android:layout_weight="1"
                android:checkable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/screen_preset_blue"
                android:textColor="@color/screen_preset_text_light"
                app:backgroundTint="@color/screen_preset_blue"
                app:cornerRadius="@dimen/screen_light_preset_corner_radius"
                app:rippleColor="@color/screen_button_ripple"
                app:strokeColor="@color/screen_preset_tile_stroke"
                app:strokeWidth="@dimen/screen_light_preset_tile_stroke_width" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</FrameLayout>
