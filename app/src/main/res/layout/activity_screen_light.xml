<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/screen_light_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_gravity="bottom"
        android:background="@color/screen_light_controls_scrim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvColor"
            android:text="@string/screen_color"
            android:textColor="@color/md_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="@string/screen_presets"
            android:textColor="@color/md_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupScreenPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetWhite"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/screen_preset_white"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetWarm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/screen_preset_warm"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetRed"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/screen_preset_red"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetBlue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/screen_preset_blue"
                android:checkable="true" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <SeekBar
            android:id="@+id/seekR"
            android:max="255"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/seekG"
            android:max="255"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/seekB"
            android:max="255"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
