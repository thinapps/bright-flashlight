<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/md_bg">

  <TextView
    android:id="@+id/txtNoFlash"
    android:text="@string/no_flash_message"
    android:textColor="@color/md_text_dim"
    android:textSize="14sp"
    android:gravity="center"
    android:visibility="gone"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center" />

  <LinearLayout
    android:id="@+id/layoutAccessNotice"
    android:orientation="vertical"
    android:gravity="center"
    android:visibility="gone"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
      android:text="@string/camera_permission_message"
      android:textColor="@color/md_text"
      android:textSize="16sp"
      android:gravity="center"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnAccessNotice"
      android:text="@string/camera_permission_button"
      android:textAllCaps="false"
      android:layout_marginTop="16dp"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      app:cornerRadius="24dp"
      app:backgroundTint="@color/md_orange"
      android:textColor="@color/md_bg" />
  </LinearLayout>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnScreenLight"
    android:text="@string/action_open_screen_light"
    android:textAllCaps="false"
    android:textSize="13sp"
    android:textColor="@color/md_text"
    android:minHeight="0dp"
    android:minWidth="0dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="20dp"
    android:layout_marginEnd="24dp"
    app:backgroundTint="@color/md_panel"
    app:cornerRadius="20dp"
    app:icon="@drawable/ic_mobile"
    app:iconGravity="textStart"
    app:iconPadding="6dp"
    app:iconSize="18dp"
    app:iconTint="@color/md_text" />

  <ScrollView
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="76dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
      android:id="@+id/mainStack"
      android:orientation="vertical"
      android:gravity="center_horizontal|bottom"
      android:layout_width="match_parent"
      android:layout_height="match_parent">

      <LinearLayout
        android:id="@+id/btnToggle"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_power_button_off"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:layout_width="184dp"
        android:layout_height="184dp">

        <TextView
          android:id="@+id/txtAutoOffCountdown"
          android:text="@string/auto_off_countdown_placeholder"
          android:textColor="@color/md_text"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:visibility="invisible"
          android:layout_width="wrap_content"
          android:layout_height="20dp" />

        <TextView
          android:id="@+id/txtPowerState"
          android:text="@string/action_torch_on"
          android:textColor="@color/md_text"
          android:textSize="18sp"
          android:textStyle="bold"
          android:letterSpacing="0.12"
          android:layout_marginTop="6dp"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/groupMode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="34dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnModeTorch">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnModeTorch"
          style="@style/Widget.App.ModeSegment"
          android:text="@string/mode_torch"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnModeStrobe"
          style="@style/Widget.App.ModeSegment"
          android:text="@string/mode_strobe"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnModeSos"
          style="@style/Widget.App.ModeSegment"
          android:text="@string/mode_sos"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
      </com.google.android.material.button.MaterialButtonToggleGroup>

      <LinearLayout
        android:id="@+id/cardAutoOff"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
          android:text="@string/timer_label"
          android:textAllCaps="true"
          android:textColor="@color/md_text_dim"
          android:textSize="12sp"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButtonToggleGroup
          android:id="@+id/groupAutoOff"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="10dp"
          app:singleSelection="true"
          app:selectionRequired="true"
          app:checkedButton="@id/btnAutoOffOff">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOffOff"
            style="@style/Widget.App.ModeSegment"
            android:text="@string/timer_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff5"
            style="@style/Widget.App.ModeSegment"
            android:text="@string/timer_5_min"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff15"
            style="@style/Widget.App.ModeSegment"
            android:text="@string/timer_15_min"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff30"
            style="@style/Widget.App.ModeSegment"
            android:text="@string/timer_30_min"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff60"
            style="@style/Widget.App.ModeSegment"
            android:text="@string/timer_1_hour"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
      </LinearLayout>

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:orientation="vertical"
          android:alpha="0.45"
          android:paddingTop="8dp"
          android:paddingBottom="12dp"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <TextView
            android:text="@string/torch_brightness"
            android:textAllCaps="true"
            android:textColor="@color/md_text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:layout_width="match_parent"
              android:layout_height="48dp"
              android:enabled="false"
              android:valueFrom="1"
              android:valueTo="10"
              android:stepSize="1"
              android:value="10"
              app:haloColor="#33FF8A3D"
              app:haloRadius="22dp"
              app:thumbColor="#FFFF8A3D"
              app:thumbElevation="6dp"
              app:thumbRadius="15dp"
              app:tickVisible="false"
              app:trackColorActive="#FFFF6A2A"
              app:trackColorInactive="#FF2C343C"
              app:trackHeight="12dp" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:id="@+id/cardBrightness"
          android:orientation="vertical"
          android:background="@color/md_bg"
          android:paddingTop="8dp"
          android:paddingBottom="12dp"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <TextView
            android:text="@string/torch_brightness"
            android:textAllCaps="true"
            android:textColor="@color/md_text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:id="@+id/sliderBrightness"
              android:layout_width="match_parent"
              android:layout_height="48dp"
              android:valueFrom="1"
              android:valueTo="10"
              android:stepSize="1"
              android:value="10"
              app:haloColor="#33FF8A3D"
              app:haloRadius="22dp"
              app:thumbColor="#FFFF8A3D"
              app:thumbElevation="6dp"
              app:thumbRadius="15dp"
              app:tickVisible="false"
              app:trackColorActive="#FFFF6A2A"
              app:trackColorInactive="#FF2C343C"
              app:trackHeight="12dp" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:orientation="vertical"
          android:alpha="0.45"
          android:paddingTop="8dp"
          android:paddingBottom="12dp"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:text="@string/strobe_speed"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="12sp"
              android:textStyle="bold"
              android:letterSpacing="0.08"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

            <ImageButton
              android:id="@+id/btnStrobeWarningPreview"
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:layout_marginStart="4dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/strobe_warning_title"
              android:padding="11dp"
              android:scaleType="centerInside"
              android:src="@drawable/ic_warning"
              android:tint="@color/md_text_dim" />

            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />

            <TextView
              android:id="@+id/txtStrobeSpeedPreviewValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.08"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="12sp"
              android:textStyle="bold" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:id="@+id/sliderStrobePreview"
              android:layout_width="match_parent"
              android:layout_height="48dp"
              android:enabled="false"
              android:valueFrom="0"
              android:valueTo="4"
              android:stepSize="1"
              android:value="1"
              app:haloColor="#33FF8A3D"
              app:haloRadius="22dp"
              app:thumbColor="#FFFF8A3D"
              app:thumbElevation="6dp"
              app:thumbRadius="15dp"
              app:tickVisible="false"
              app:trackColorActive="#FFFF6A2A"
              app:trackColorInactive="#FF2C343C"
              app:trackHeight="12dp" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:id="@+id/cardStrobe"
          android:orientation="vertical"
          android:background="@color/md_bg"
          android:paddingTop="8dp"
          android:paddingBottom="12dp"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/txtStrobeSpeed"
              android:text="@string/strobe_speed"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="12sp"
              android:textStyle="bold"
              android:letterSpacing="0.08"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

            <ImageButton
              android:id="@+id/btnStrobeWarning"
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:layout_marginStart="4dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/strobe_warning_title"
              android:padding="11dp"
              android:scaleType="centerInside"
              android:src="@drawable/ic_warning"
              android:tint="@color/md_text_dim" />

            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />

            <TextView
              android:id="@+id/txtStrobeSpeedValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.08"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="12sp"
              android:textStyle="bold" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:id="@+id/sliderStrobe"
              android:layout_width="match_parent"
              android:layout_height="48dp"
              android:valueFrom="0"
              android:valueTo="4"
              android:stepSize="1"
              android:value="1"
              app:haloColor="#33FF8A3D"
              app:haloRadius="22dp"
              app:thumbColor="#FFFF8A3D"
              app:thumbElevation="6dp"
              app:thumbRadius="15dp"
              app:tickVisible="false"
              app:trackColorActive="#FFFF6A2A"
              app:trackColorInactive="#FF2C343C"
              app:trackHeight="12dp" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>
  </ScrollView>
</FrameLayout>
