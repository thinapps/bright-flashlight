<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:background="@color/md_bg"
  android:clipChildren="false"
  android:clipToPadding="false"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ScrollView
    android:background="@color/md_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
      android:orientation="vertical"
      android:gravity="bottom"
      android:clipChildren="false"
      android:clipToPadding="false"
      android:paddingStart="@dimen/app_gutter"
      android:paddingTop="@dimen/home_top_padding"
      android:paddingEnd="@dimen/app_gutter"
      android:paddingBottom="@dimen/home_bottom_padding"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <LinearLayout
        android:id="@+id/layoutMainControls"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/main_controls_bottom_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Space
          android:id="@+id/spacePowerTop"
          android:layout_width="1dp"
          android:layout_height="0dp"
          android:visibility="gone" />

        <FrameLayout
          android:id="@+id/layoutPowerButton"
          android:layout_width="@dimen/power_button_size"
          android:layout_height="@dimen/power_button_size"
          android:layout_gravity="center_horizontal"
          android:clipChildren="false"
          android:clipToPadding="false">

          <View
            android:id="@+id/viewPowerHalo"
            android:layout_width="@dimen/power_halo_size"
            android:layout_height="@dimen/power_halo_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_active_glow"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="invisible" />

          <FrameLayout
            android:id="@+id/btnToggle"
            android:layout_width="@dimen/power_button_size"
            android:layout_height="@dimen/power_button_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_power_button_off"
            android:clickable="true"
            android:contentDescription="@string/action_torch_on"
            android:elevation="@dimen/power_button_elevation"
            android:focusable="true">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="center"
              android:orientation="vertical"
              android:paddingStart="@dimen/power_button_padding_horizontal"
              android:paddingTop="@dimen/power_button_padding_top"
              android:paddingEnd="@dimen/power_button_padding_horizontal"
              android:paddingBottom="@dimen/power_button_padding_bottom">

              <ImageView
                android:id="@+id/imgPowerIcon"
                android:layout_width="@dimen/power_icon_size"
                android:layout_height="@dimen/power_icon_size"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_power" />

              <TextView
                android:id="@+id/txtAutoOffCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/power_countdown_top_margin"
                android:background="@drawable/bg_power_countdown_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/power_countdown_min_height"
                android:paddingStart="@dimen/power_countdown_pill_padding_horizontal"
                android:paddingTop="@dimen/power_countdown_pill_padding_vertical"
                android:paddingEnd="@dimen/power_countdown_pill_padding_horizontal"
                android:paddingBottom="@dimen/power_countdown_pill_padding_vertical"
                android:text="@string/auto_off_countdown_placeholder"
                android:textColor="@color/md_text"
                android:textSize="@dimen/power_countdown_text_size"
                android:textStyle="bold"
                android:visibility="invisible" />

              <TextView
                android:id="@+id/txtPowerState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/power_label_top_margin"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/action_torch_on"
                android:textAllCaps="true"
                android:textColor="@color/md_text"
                android:textSize="@dimen/power_label_text_size"
                android:textStyle="bold" />
            </LinearLayout>
          </FrameLayout>
        </FrameLayout>

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="@dimen/mode_label_top_margin"
          android:letterSpacing="0.10"
          android:text="@string/mode_label"
          android:textAllCaps="true"
          android:textColor="@color/md_text_dim"
          android:textSize="@dimen/section_label_text_size"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
          android:id="@+id/groupMode"
          android:layout_width="match_parent"
          android:layout_height="@dimen/segmented_control_height"
          android:layout_marginTop="@dimen/segmented_control_top_margin"
          android:background="@drawable/bg_segmented_control_rail"
          android:padding="@dimen/segmented_control_padding"
          app:singleSelection="true"
          app:selectionRequired="true"
          app:checkedButton="@id/btnModeTorch">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeTorch"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/mode_torch"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/control_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeStrobe"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/mode_strobe"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/control_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeSos"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/mode_sos"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/control_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
          android:id="@+id/layoutAccessNotice"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/access_notice_top_margin"
          android:orientation="vertical"
          android:visibility="gone">

          <TextView
            android:id="@+id/txtAccessNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_permission_message"
            android:textColor="@color/md_text_dim" />

          <Button
            android:id="@+id/btnAccessNotice"
            android:layout_width="match_parent"
            android:layout_height="@dimen/access_button_height"
            android:layout_marginTop="@dimen/access_button_top_margin"
            android:text="@string/camera_permission_button" />
        </LinearLayout>

        <TextView
          android:id="@+id/txtNoFlash"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/no_flash_top_margin"
          android:text="@string/no_flash_message"
          android:textColor="@color/md_text_dim"
          android:visibility="gone" />

      </LinearLayout>

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:orientation="vertical"
          android:alpha="0.45"
          android:paddingTop="@dimen/slider_section_padding_top"
          android:paddingBottom="@dimen/slider_section_padding_bottom"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:text="@string/torch_brightness"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold"
              android:letterSpacing="0.08"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />

            <TextView
              android:id="@+id/txtBrightnessPreviewValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.08"
              android:text="@string/brightness_level_max"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_well_height"
            android:layout_marginTop="@dimen/slider_well_top_margin"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:layout_width="match_parent"
              android:layout_height="@dimen/slider_height"
              android:enabled="false"
              android:valueFrom="1"
              android:valueTo="10"
              android:stepSize="1"
              android:value="10"
              app:haloColor="@color/slider_halo"
              app:haloRadius="@dimen/slider_halo_radius"
              app:thumbColor="@color/slider_thumb"
              app:thumbElevation="@dimen/slider_thumb_elevation"
              app:thumbRadius="@dimen/slider_thumb_radius"
              app:tickVisible="false"
              app:trackColorActive="@color/slider_track_active"
              app:trackColorInactive="@color/slider_track_inactive"
              app:trackHeight="@dimen/slider_track_height" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:id="@+id/cardBrightness"
          android:orientation="vertical"
          android:background="@color/md_bg"
          android:paddingTop="@dimen/slider_section_padding_top"
          android:paddingBottom="@dimen/slider_section_padding_bottom"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:text="@string/torch_brightness"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold"
              android:letterSpacing="0.08"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />

            <TextView
              android:id="@+id/txtBrightnessValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.08"
              android:text="@string/brightness_level_max"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_well_height"
            android:layout_marginTop="@dimen/slider_well_top_margin"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:id="@+id/sliderBrightness"
              android:layout_width="match_parent"
              android:layout_height="@dimen/slider_height"
              android:valueFrom="1"
              android:valueTo="10"
              android:stepSize="1"
              android:value="10"
              app:haloColor="@color/slider_halo"
              app:haloRadius="@dimen/slider_halo_radius"
              app:thumbColor="@color/slider_thumb"
              app:thumbElevation="@dimen/slider_thumb_elevation"
              app:thumbRadius="@dimen/slider_thumb_radius"
              app:tickVisible="false"
              app:trackColorActive="@color/slider_track_active"
              app:trackColorInactive="@color/slider_track_inactive"
              app:trackHeight="@dimen/slider_track_height" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:orientation="vertical"
          android:alpha="0.45"
          android:paddingTop="@dimen/slider_section_padding_top"
          android:paddingBottom="@dimen/slider_section_padding_bottom"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:text="@string/strobe_speed"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold"
              android:letterSpacing="0.08"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

            <ImageButton
              android:id="@+id/btnStrobeWarningPreview"
              android:layout_width="@dimen/warning_button_size"
              android:layout_height="@dimen/warning_button_size"
              android:layout_marginStart="@dimen/warning_button_margin_start"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/strobe_warning_title"
              android:padding="@dimen/warning_button_padding"
              android:src="@drawable/ic_warning"
              android:tint="@color/md_text_dim" />

            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />

            <TextView
              android:id="@+id/txtStrobeSpeedPreviewValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.08"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_well_height"
            android:layout_marginTop="@dimen/slider_well_top_margin"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:id="@+id/sliderStrobePreview"
              android:layout_width="match_parent"
              android:layout_height="@dimen/slider_height"
              android:enabled="false"
              android:valueFrom="0"
              android:valueTo="4"
              android:stepSize="1"
              android:value="1"
              app:haloColor="@color/slider_halo"
              app:haloRadius="@dimen/slider_halo_radius"
              app:thumbColor="@color/slider_thumb"
              app:thumbElevation="@dimen/slider_thumb_elevation"
              app:thumbRadius="@dimen/slider_thumb_radius"
              app:tickVisible="false"
              app:trackColorActive="@color/slider_track_active"
              app:trackColorInactive="@color/slider_track_inactive"
              app:trackHeight="@dimen/slider_track_height" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
          android:id="@+id/cardStrobe"
          android:orientation="vertical"
          android:background="@color/md_bg"
          android:paddingTop="@dimen/slider_section_padding_top"
          android:paddingBottom="@dimen/slider_section_padding_bottom"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/txtStrobeSpeed"
              android:text="@string/strobe_speed"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold"
              android:letterSpacing="0.08"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

            <ImageButton
              android:id="@+id/btnStrobeWarning"
              android:layout_width="@dimen/warning_button_size"
              android:layout_height="@dimen/warning_button_size"
              android:layout_marginStart="@dimen/warning_button_margin_start"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:contentDescription="@string/strobe_warning_title"
              android:padding="@dimen/warning_button_padding"
              android:src="@drawable/ic_warning"
              android:tint="@color/md_text_dim" />

            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />

            <TextView
              android:id="@+id/txtStrobeSpeedValue"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.08"
              android:textAllCaps="true"
              android:textColor="@color/md_text_dim"
              android:textSize="@dimen/section_label_text_size"
              android:textStyle="bold" />
          </LinearLayout>

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/slider_well_height"
            android:layout_marginTop="@dimen/slider_well_top_margin"
            android:background="@drawable/bg_slider_hardware_well"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.slider.Slider
              android:id="@+id/sliderStrobe"
              android:layout_width="match_parent"
              android:layout_height="@dimen/slider_height"
              android:valueFrom="0"
              android:valueTo="4"
              android:stepSize="1"
              android:value="1"
              app:haloColor="@color/slider_halo"
              app:haloRadius="@dimen/slider_halo_radius"
              app:thumbColor="@color/slider_thumb"
              app:thumbElevation="@dimen/slider_thumb_elevation"
              app:thumbRadius="@dimen/slider_thumb_radius"
              app:tickVisible="false"
              app:trackColorActive="@color/slider_track_active"
              app:trackColorInactive="@color/slider_track_inactive"
              app:trackHeight="@dimen/slider_track_height" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>

      <LinearLayout
        android:id="@+id/cardAutoOff"
        android:orientation="vertical"
        android:paddingTop="@dimen/slider_section_padding_top"
        android:paddingBottom="@dimen/slider_section_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
          android:text="@string/timer_label"
          android:textAllCaps="true"
          android:textColor="@color/md_text_dim"
          android:textSize="@dimen/section_label_text_size"
          android:textStyle="bold"
          android:letterSpacing="0.08"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButtonToggleGroup
          android:id="@+id/groupAutoOff"
          android:layout_width="match_parent"
          android:layout_height="@dimen/segmented_control_height"
          android:layout_marginTop="@dimen/slider_section_padding_bottom"
          android:background="@drawable/bg_segmented_control_rail"
          android:padding="@dimen/segmented_control_padding"
          app:singleSelection="true"
          app:selectionRequired="true"
          app:checkedButton="@id/btnAutoOffOff">

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOffOff"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/timer_off"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/section_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_auto_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff5"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/timer_5_min"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/section_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_auto_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff15"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/timer_15_min"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/section_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_auto_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff30"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/timer_30_min"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/section_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_auto_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoOff60"
            android:layout_width="0dp"
            android:layout_height="@dimen/segmented_control_button_height"
            android:layout_weight="1"
            android:checkable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/timer_1_hour"
            android:textAllCaps="true"
            android:textColor="@color/md_text"
            android:textSize="@dimen/section_label_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/segmented_control_button_bg"
            app:cornerRadius="@dimen/segmented_control_auto_button_corner_radius"
            app:rippleColor="@color/segmented_control_ripple"
            app:strokeColor="@color/segmented_control_stroke"
            app:strokeWidth="@dimen/segmented_control_stroke_width" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
      </LinearLayout>

      <TextView
        android:id="@+id/txtHomeFooterMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_footer_top_margin"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/home_footer_line_spacing"
        android:text="@string/home_footer_message"
        android:textColor="@color/md_text_dim"
        android:textSize="@dimen/section_label_text_size" />

    </LinearLayout>
  </ScrollView>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnScreenLight"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/screen_button_height"
    android:layout_gravity="top|end"
    android:layout_marginTop="@dimen/screen_button_margin_top"
    android:layout_marginEnd="@dimen/screen_button_margin_end"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:paddingStart="@dimen/screen_button_padding_start"
    android:paddingEnd="@dimen/screen_button_padding_end"
    android:text="@string/action_open_screen_light"
    android:textAllCaps="true"
    android:textColor="@color/md_text"
    android:textSize="@dimen/section_label_text_size"
    android:textStyle="bold"
    app:backgroundTint="@color/screen_button_bg"
    app:cornerRadius="@dimen/screen_button_corner_radius"
    app:elevation="@dimen/screen_button_elevation"
    app:icon="@drawable/ic_mobile"
    app:iconGravity="textStart"
    app:iconPadding="@dimen/screen_button_icon_padding"
    app:iconTint="@color/md_text"
    app:rippleColor="@color/screen_button_ripple" />
</FrameLayout>
